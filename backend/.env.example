# Database
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/vibecoding?client_encoding=utf8

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
JWT_SECRET=change-me-in-production
UPLOAD_DIR=uploads

# 사람인 Open API (https://oapi.saramin.co.kr/)
# 이용신청 승인 후 Application > 앱 등록에서 access-key 발급
SARAMIN_API_KEY=
SARAMIN_API_URL=https://oapi.saramin.co.kr/job-search
# 선택: IT개발·데이터 상위직무코드(예: 22). 비우면 keywords만 사용
SARAMIN_JOB_MID_CD=

# 잡코리아 파트너 API (https://www.jobkorea.co.kr/service/api)
# 승인 후 발급되는 고유 호출링크 전체를 넣습니다 (키가 아닌 URL)
JOBKOREA_API_URL=

# 공통 수집 설정
JOBS_KEYWORDS=개발자
JOBS_FETCH_COUNT=50

# 기술스택 한글→영문 정규화 AI (선택)
# 비워두면 내장 사전만 사용 (파이썬→Python, 자바→Java 등)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 카카오 지도/장소 검색 (https://developers.kakao.com/console/app)
# 다른 PC: 이 파일을 backend/.env 로 복사한 뒤 DB 등 나머지 값도 채우세요.
# JS 키 도메인에 http://localhost:5173 , http://localhost:8080 등록 + 해당 앱 카카오맵 ON
KAKAO_REST_API_KEY=7b50e80be47b5fe40d9671cc041535c4
KAKAO_JS_KEY=6e274cbee108cdcbf88799e5b525f546
